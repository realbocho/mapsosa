NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-javascript-key

# Kakao OpenID Connect flow (the Kakao client secret is server-only).
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# Never expose Kakao client secrets or Supabase service-role keys in NEXT_PUBLIC variables.
